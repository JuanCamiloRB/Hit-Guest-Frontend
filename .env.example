# Browser-safe configuration
NEXT_PUBLIC_API_URL_GUEST=https://guest.hit.tools/api/v1
NEXT_PUBLIC_API_URL_HIT=https://guest.hit.tools/api/v1
NEXT_PUBLIC_ENABLE_MOCKS=false

# Server-only secrets — never prefix these with NEXT_PUBLIC_
APP_API_TOKEN=
# Free native mode is the default: explicit search via OpenStreetMap/Nominatim.
# It does not need a key and intentionally does not query on every keystroke.

# Optional commercial autocomplete provider. This key remains server-only.
# GEOCODING_PROVIDER=google
# GOOGLE_MAPS_API_KEY=

# Optional autocomplete while typing with a self-hosted/managed Nominatim.
# GEOCODING_PROVIDER=nominatim
# NOMINATIM_BASE_URL=https://nominatim.example.com
