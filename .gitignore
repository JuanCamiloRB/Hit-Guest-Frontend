# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
service-account*.json
google-services.json
GoogleService-Info.plist

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# File-sync duplicates (iCloud/Dropbox), e.g. "catalog 2.ts" or
# "catalog 17.ts". The numeric suffix is not stable, so do not special-case 2.
* [0-9]*.ts
* [0-9]*.tsx
* [0-9]*.js
* [0-9]*.jsx

# Local agent tooling (symlinked skills, agent state)
.agents/
.claude/skills/agent-browser
skills-lock.json
